# =============================================================================
# Nodejs-WSS-Tunnel — Server env example for a VPS / dedicated server
# =============================================================================
# For a VPS (DigitalOcean, Vultr, Hetzner, ...) where the server can bind any
# TCP port. The server itself opens `TCP_TUNNEL_PORTS` and forwards connections
# through the tunnel client to the service machine:
#
#   redis-cli --TCP <server>:6379--> server (TCP_TUNNEL_PORTS)
#   server --TCP_OPEN--> tunnel client --> 127.0.0.1:6379 on client machine
#
# The HTTP tunnel also works here (TUNNEL_PATH=/tunnel). Agent mode (mode [B])
# is optional on a VPS and can coexist with direct mode.
#
# Copy this file to `.env` (development) or export the variables yourself
# in production (docker --env-file, systemd Environment=, export, ...).
#
#   NOTE: src/shared/config.js auto-loads `.env` ONLY when NODE_ENV is unset or
#   "development". With NODE_ENV=production you must provide the variables
#   yourself (docker --env-file, systemd Environment=, export, ...).
#
# If your host exposes only ONE public port (Render/Railway/Fly.io),
# use .env.example.single-port instead of this file.
# =============================================================================

# --- Runtime -----------------------------------------------------------------
# development | production | test
NODE_ENV=development

# --- Core server --------------------------------------------------------------
# HTTP/WS listen port on the server (int, 1-65535, default 7860)
PORT=7860

# Public URL of the tunnel server (http or https). Used for install links.
# On a VPS with a domain: https://tunnel.example.com
SERVER_HOST=http://localhost:7860

# WS path the HTTP tunnel clients connect to (must start with "/" and
# must differ from TCP_AGENT_PATH).
TUNNEL_PATH=/tunnel

# Pin this! If left empty a NEW random UUID is generated on every server
# restart and every artifact/install URL changes (breaks installed clients).
# Generate once, e.g. `node -e "console.log(crypto.randomUUID())"`, and pin it.
# You can find the current value in the server log:
#   "[standard] [ws] startup ... installUuid=<uuid>"
INSTALL_UUID=

# --- Authentication (REQUIRED) ------------------------------------------------
# The server refuses to start without both set.
# Use long, random values; never commit real credentials.
TUNNEL_USERNAME=your_username
TUNNEL_PASSWORD=your_password

# Secret token for admin endpoints (e.g. the /config endpoint that toggles
# VERBOSE / LOG_FORMAT at runtime). Empty = admin endpoints disabled.
ADMIN_SECRET=

# --- HTTP tunnel performance / flow control (server) ---------------------------
# Max concurrent streams across all tunneled connections (int, min 1, default 200)
MAX_CONCURRENT_STREAMS=200

# Close a stream after this idle time in ms (int, min 0, default 120000; 0 = disabled)
STREAM_IDLE_TIMEOUT_MS=120000

# Timeout in ms to drain remaining data before closing a stream
# (int, min 0, default 30000)
DRAIN_TIMEOUT_MS=30000

# WS outbound buffer high-water mark in bytes (flow-control threshold;
# int, min 1024, default 1048576)
WS_HIGH_WATER_BYTES=1048576

# WS low-water mark in bytes; MUST be < WS_HIGH_WATER_BYTES.
# Empty = half of WS_HIGH_WATER_BYTES (default).
WS_LOW_WATER=

# Max frame payload in bytes (int, min 1, default 262144);
# MUST be <= WS_MAX_PAYLOAD_BYTES - 64
MAX_FRAME_PAYLOAD_BYTES=262144

# Max WS message payload in bytes (int, min 1024, default 2097152)
WS_MAX_PAYLOAD_BYTES=2097152

# Max destination buffer in bytes (int, min 1024, default 8388608)
MAX_DEST_BUFFER_BYTES=8388608

# Node http server request timeout in ms (default 0 = disabled)
HTTP_REQUEST_TIMEOUT_MS=0

# --- TCP tunnel, mode [A] server-listen  (VPS: bind ports directly) -----------
# Target host the tunnel client dials on ITS machine (default 127.0.0.1).
# This is the host the server asks the client to connect to for TCP_OPEN.
TCP_TUNNEL_HOST=127.0.0.1

# Comma-separated ports the server itself listens on and forwards to the
# tunnel client. Empty = this mode disabled.
# On a VPS you CAN bind real ports, e.g. 6379,5432 for Redis + Postgres.
# NOTE: do not pick a port that is already in use by a service on the server.
TCP_TUNNEL_PORTS=6379,5432

# Interface the server TCP listeners bind to.
# 127.0.0.1 = server-local only (apps must be on the same host);
# 0.0.0.0 = reachable from anywhere (then set TCP_TUNNEL_ALLOWED_IPS!).
# For external apps to reach the tunneled service, use 0.0.0.0 here.
TCP_TUNNEL_BIND_HOST=0.0.0.0

# Comma-separated CIDR/IP allowlist for incoming TCP connections on the
# server listeners (empty = allow all). With BIND 0.0.0.0 this is REQUIRED
# for production — otherwise tunneled services are public to the internet.
# Examples: 192.168.1.0/24, 203.0.113.5
TCP_TUNNEL_ALLOWED_IPS=0.0.0.0/0

# Comma-separated hostnames/IPs the tunnel client may dial (default:
# TCP_TUNNEL_HOST). Keep 127.0.0.1 unless you trust the target hosts.
TCP_CLIENT_ALLOWED_HOSTS=127.0.0.1

# --- TCP tunnel, mode [B] agent over WS  (optional on a VPS) ------------------
# WS path agents connect to (must start with "/", differ from TUNNEL_PATH).
TCP_AGENT_PATH=/tcp

# Comma-separated ports agents are allowed to open. Empty = agent endpoint
# disabled. Only needed if apps on OTHER hosts must use the agent instead of
# connecting to TCP_TUNNEL_PORTS directly. Keep empty unless you use agents.
TCP_AGENT_ALLOWED_PORTS=

# Agent credentials (default: TUNNEL_USERNAME / TUNNEL_PASSWORD).
# The agent falls back to TUNNEL_* if these are not set.
# TCP_AGENT_USERNAME=agent
# TCP_AGENT_PASSWORD=agent_secret

# Comma-separated Origin allowlist for /tcp upgrades (empty = allow any
# Origin; a present Origin not in the list is rejected; no Origin is allowed)
# TCP_AGENT_ALLOWED_ORIGINS=

# Require TLS for /tcp upgrades (accepts req.socket.encrypted or
# X-Forwarded-Proto: https behind a TLS-terminating proxy)
TCP_AGENT_REQUIRE_TLS=false

# Max concurrent streams per agent connection (int, min 0, default 100; 0 = unlimited)
TCP_AGENT_MAX_STREAMS_PER_AGENT=100

# --- TCP generic (server + client) ----------------------------------------------
# Timeout in ms for the tunnel client to establish the local TCP connection
# (int, min 0, default 10000)
TCP_CONNECT_TIMEOUT_MS=10000

# Max concurrent TCP connections per tunneled port (int, min 0, default 20; 0 = unlimited)
TCP_MAX_CONNECTIONS_PER_PORT=20

# Timeout in ms to drain active TCP streams during server shutdown
# (int, min 0, default 5000)
TCP_SHUTDOWN_DRAIN_TIMEOUT_MS=5000

# --- Logging (server, client and agent all share these) -------------------------
# text | json
LOG_FORMAT=text

# true = verbose per-event logging, keyed by streamId so a single TCP stream
# can be followed across agent -> server -> client (large volume; debug only)
VERBOSE=false

# =============================================================================
# REFERENCE — tunnel client bundle  (service machine, runs dist/client.js)
# =============================================================================
#
# Required:
#   TUNNEL_SERVER_URL=wss://<SERVER_HOST>/tunnel   # WS URL, /tunnel path
#   TUNNEL_USERNAME / TUNNEL_PASSWORD              # same as server
#
# Optional (defaults shown):
#   TARGET_ORIGIN=http://127.0.0.1:8000            # local HTTP app to share
#   TCP_TUNNEL_HOST=127.0.0.1                      # local TCP host to share
#   TCP_CLIENT_ALLOWED_HOSTS=127.0.0.1             # hosts the client may dial
#   TCP_CONNECT_TIMEOUT_MS=10000                   # local TCP dial timeout
#   LOCAL_REQUEST_TIMEOUT_MS=0                     # HTTP req timeout to local app
#   TARGET_TLS_REJECT_UNAUTHORIZED=                # set 0 to allow self-signed local HTTPS target
#   MAX_CONCURRENT_STREAMS=200                     # same meaning as server
#   STREAM_IDLE_TIMEOUT_MS=120000                  # per-stream idle timeout
#   DRAIN_TIMEOUT_MS=30000                         # drain before closing
#   WS_HIGH_WATER_BYTES=1048576                    # WS flow-control high-water
#   MAX_FRAME_PAYLOAD_BYTES=262144                 # max frame payload
#   VERBOSE / LOG_FORMAT                           # see Logging section
#   TUNNEL_WORK_DIR=$HOME/.tunnel-client           # dir for ready/pid/log files
#   TUNNEL_READY_FILE=<WORK_DIR>/client.ready      # written once connected (installer polls it)
#   TUNNEL_CAPTURE_FILE=                           # installer passthrough for output capture
#
# Verbose events (VERBOSE=true): start, connected, disconnected, reconnect,
#   auth_failed, error, shutdown (standard);
#   tcp_open_received {streamId,host,port}, heartbeat_sent, heartbeat_received,
#   stream_closed {streamId} (verbose).

# =============================================================================
# REFERENCE — TCP agent bundle  (app host, runs dist/tcp-agent.js)
# =============================================================================
#
# Required:
#   TUNNEL_SERVER_URL=wss://<SERVER_HOST>/tcp      # WS URL, /tcp path
#   AGENT_PORTS=6379                               # comma-separated local ports to expose
#   credentials (AGENT_USERNAME/AGENT_PASSWORD OR TUNNEL_USERNAME/TUNNEL_PASSWORD)
#
# Optional (defaults shown):
#   AGENT_BIND_HOST=127.0.0.1                      # loopback where local apps connect
#   AGENT_RECONNECT_DELAY_MS=1000                  # initial reconnect backoff (ms)
#   WS_HIGH_WATER_BYTES=1048576                    # WS flow-control high-water
#   AGENT_USERNAME / AGENT_PASSWORD                # override auth (default: TUNNEL_*)
#   VERBOSE / LOG_FORMAT                           # see Logging section
#
# Verbose events (VERBOSE=true): start, listening, connected, disconnected,
#   reconnect, auth_failed, error, shutdown (standard);
#   local_connect_received {port,pending}, tcp_connect_sent {port},
#   connect_ack_received {port,streamId}, connect_rejected {port,message},
#   stream_registered {streamId,port}, stream_closed {streamId,port},
#   stream_aborted {streamId,message} (verbose).

# =============================================================================
# Testing only (NOT a runtime server var)
# =============================================================================
#
#   REQUIRE_TCP_SERVICES=1  # make real Redis/Postgres integration tests FAIL
#                           # instead of skip when the services are unavailable.
#                           # Used by .github/workflows/ci.yml.
#   e.g. REQUIRE_TCP_SERVICES=1 node --test test/tcp-real-integration.test.js test/tcp-stress.test.js

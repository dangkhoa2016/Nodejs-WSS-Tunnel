# ==========================================
# Server Configuration
# ==========================================

# Port on which the application server will run
PORT=7860

# Base URL path for the tunnel endpoint
TUNNEL_PATH=/tunnel

# Public or local host URL of the server
SERVER_HOST=http://localhost:7860

# Unique installation identifier (leave blank to auto-generate if applicable)
INSTALL_UUID=


# ==========================================
# Authentication (Required)
# ==========================================

# Username required for tunnel authentication
TUNNEL_USERNAME=your_username

# Password required for tunnel authentication
TUNNEL_PASSWORD=your_password


# ==========================================
# Performance & Network Tuning (Optional)
# ==========================================

# Maximum number of concurrent streams allowed
MAX_CONCURRENT_STREAMS=200

# Stream idle timeout in milliseconds before closing connection
STREAM_IDLE_TIMEOUT_MS=120000

# WebSocket high water mark in bytes (flow control threshold)
WS_HIGH_WATER_BYTES=1048576

# WebSocket low water mark in bytes (flow control threshold; default is half of WS_HIGH_WATER_BYTES)
WS_LOW_WATER=

# Maximum frame payload size in bytes
MAX_FRAME_PAYLOAD_BYTES=262144

# Maximum WebSocket payload size in bytes (2MB)
WS_MAX_PAYLOAD_BYTES=2097152

# Maximum destination buffer size in bytes (8MB)
MAX_DEST_BUFFER_BYTES=8388608

# Timeout in milliseconds to drain remaining data before closing
DRAIN_TIMEOUT_MS=30000

# HTTP request timeout in milliseconds (0 = disabled/infinite)
HTTP_REQUEST_TIMEOUT_MS=0


# ==========================================
# TCP Tunnel (Optional)
# ==========================================

# Host the tunneled TCP service resolves to on the client machine
TCP_TUNNEL_HOST=127.0.0.1

# Comma-separated ports to expose via the TCP tunnel (empty = disabled)
TCP_TUNNEL_PORTS=

# Interface the TCP tunnel listeners bind to on the server
TCP_TUNNEL_BIND_HOST=127.0.0.1

# Comma-separated CIDR/IP allowlist for incoming TCP connections (empty = allow all)
TCP_TUNNEL_ALLOWED_IPS=

# Comma-separated hostnames/IPs the tunnel client may connect to (default: TCP_TUNNEL_HOST)
TCP_CLIENT_ALLOWED_HOSTS=127.0.0.1

# Timeout in milliseconds for the client to establish the TCP connection
TCP_CONNECT_TIMEOUT_MS=10000

# Maximum concurrent TCP connections per tunneled port (0 = unlimited)
TCP_MAX_CONNECTIONS_PER_PORT=20

# Timeout in milliseconds to drain active TCP streams during shutdown
TCP_SHUTDOWN_DRAIN_TIMEOUT_MS=5000


# ==========================================
# Admin Control & Security
# ==========================================

# Secret token required to access administrative endpoints
ADMIN_SECRET=


# ==========================================
# Logging
# ==========================================

# Log output format (e.g., text, json)
LOG_FORMAT=text

# Enable verbose logging mode (true/false)
VERBOSE=false
